    {
      "name": "2 · CRUD en DynamoDB · leads (MS3)",
      "description": "Crear → modificar → eliminar, mirando la tabla crm-ms3-dev-leads en la consola de DynamoDB.",
      "item": [
        {
          "name": "(1) CREAR lead · POST /ms3/leads",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ms3}}/ms3/leads",
              "host": [
                "{{ms3}}"
              ],
              "path": [
                "ms3",
                "leads"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_andina}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empresa\": \"Postman Demo {{sufijo}}\",\n  \"nombre\": \"Lucía\",\n  \"apellido\": \"Ramos\",\n  \"cargo\": \"Gerente de operaciones\",\n  \"email\": \"lucia{{sufijo}}@postmandemo.pe\",\n  \"telefono\": \"9{{sufijo}}\",\n  \"fuente\": \"referido\",\n  \"empleados\": 120,\n  \"monto_estimado\": 18000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Ver en DynamoDB → crm-ms3-dev-leads: aparece sk = LEAD#<lead_id> y las marcas EMAIL# y TEL#."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set(\"sufijo\", s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const l = pm.response.json(); pm.collectionVariables.set(\"lead_id\", l.lead_id);",
                  "pm.test(\"Se puntuó y se asignó\", () => { pm.expect(l.puntaje).to.be.above(0); pm.expect(l.estado).to.eql(\"nuevo\"); });"
                ]
              }
            }
          ]
        },
