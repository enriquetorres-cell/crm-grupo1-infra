              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"tenant_nexo\",\n  \"email\": \"admin@nexo.pe\",\n  \"password\": \"DemoNexo2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Devuelve el token Bearer (8 h). El script lo guarda en una variable de la colección."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token_nexo\", pm.response.json().token);",
                  "pm.test(\"Token guardado en {{token_nexo}}\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
