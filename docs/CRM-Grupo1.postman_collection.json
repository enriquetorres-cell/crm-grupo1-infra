    {
      "name": "1 · Login: cómo se identifica al tenant",
      "description": "Correr primero. El tenant NUNCA viaja en el body ni en la URL: sale del token, que valida el Lambda Authorizer de MS1.",
      "item": [
        {
          "name": "Login Andina (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ms1}}/ms1/login",
              "host": [
                "{{ms1}}"
              ],
              "path": [
                "ms1",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"tenant_andina\",\n  \"email\": \"admin@andina.pe\",\n  \"password\": \"DemoAndina2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Devuelve el token Bearer (8 h). El script lo guarda en una variable de la colección."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token_andina\", pm.response.json().token);",
                  "pm.test(\"Token guardado en {{token_andina}}\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Nexo (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
