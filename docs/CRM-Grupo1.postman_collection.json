              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_andina}}",
                  "type": "string"
                }
              ]
            },
            "description": "Borra en una transacción el lead, sus marcas EMAIL#/TEL# y descuenta la carga del vendedor."
