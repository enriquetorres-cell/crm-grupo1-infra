              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"contactado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "En DynamoDB el ítem cambia estado y aparece actualizado_en."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado = contactado\", () => pm.expect(pm.response.json().estado).to.eql(\"contactado\"));"
                ]
              }
            }
          ]
        },
